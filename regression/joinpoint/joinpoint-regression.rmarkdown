#points(data_melanoma_arm$Year, data_melanoma_arm$Rate)
plot.segmented(out.glm.best_leg, link = FALSE, add = TRUE, col="purple")
#points(data_melanoma_leg$Year, data_melanoma_leg$Rate)
plot.segmented(out.glm.best, link = FALSE, add = TRUE, col="black")
